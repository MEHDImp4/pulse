# Docker environment — Linux-compatible paths.
# Copy to .env.docker and fill in your Discord credentials: cp .env.docker.example .env.docker
DISCORD_TOKEN=YOUR_DISCORD_TOKEN_HERE
DISCORD_CLIENT_ID=YOUR_CLIENT_ID_HERE
# Development only. Leave empty to deploy global commands.
DISCORD_GUILD_ID=

LOG_LEVEL=info
IDLE_TIMEOUT_SECONDS=300
EMPTY_CHANNEL_TIMEOUT_SECONDS=60
MAX_QUEUE_SIZE=100
MAX_TRACK_DURATION_MINUTES=180
MAX_STREAM_RETRIES=2
# Abort and retry a track if audio has not started playing within this delay (ms)
STREAM_START_TIMEOUT_MS=20000
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
EXTERNAL_PROCESS_TIMEOUT_MS=20000
VOICE_CONNECTION_TIMEOUT_MS=20000
# Short-lived cache for stable yt-dlp metadata (search/link). 0 disables it.
METADATA_CACHE_TTL_MS=600000
METADATA_CACHE_MAX_ENTRIES=500
# Directory where per-guild settings are persisted (mounted volume)
DATA_DIR=/data

# Feature flags & tuning
COMMAND_COOLDOWN_SECONDS=5
# Auto-delete bot confirmation messages after N seconds (0 disables). Messages with buttons are kept.
AUTO_DELETE_SECONDS=1
SPONSORBLOCK_CATEGORIES=sponsor,selfpromo
YTDLP_AUTO_UPDATE=true
# Optional: mount a cookies file for age-restricted / anti-bot videos.
# YTDLP_COOKIES_FILE=/app/cookies.txt
NOWPLAYING_LIVE=true
# Refresh interval of the live now-playing card (ms)
NOWPLAYING_INTERVAL_MS=1000
VOTE_SKIP_MIN=2
VOTE_SKIP_RATIO=0.5
VOLUME_STEP=5
# Perceptual volume curve: 100% = -VOLUME_HEADROOM_DB, down to VOLUME_RANGE_DB spread
VOLUME_HEADROOM_DB=3
VOLUME_RANGE_DB=30
AUTOCOMPLETE_ENABLED=true
SUGGEST_TIMEOUT_MS=800

# Autoplay / radio
AUTOPLAY_DEFAULT=true
# 0 = unlimited; a high value acts as a safety cap
AUTOPLAY_MAX_CONSECUTIVE=1000
AUTOPLAY_HISTORY=100
AUTOPLAY_RETRY_MS=30000
AUTOPLAY_EMPTY_TIMEOUT_SECONDS=1800
# Persist and resume per-session queues after a restart
QUEUE_PERSIST=true
QUEUE_PERSIST_DEBOUNCE_MS=1000
RESUME_ON_STARTUP=true
RESUME_MAX_AGE_MINUTES=1440

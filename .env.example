DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Development only. Leave empty to deploy global commands.
DISCORD_GUILD_ID=

LOG_LEVEL=info
IDLE_TIMEOUT_SECONDS=300
EMPTY_CHANNEL_TIMEOUT_SECONDS=60
MAX_QUEUE_SIZE=100
MAX_TRACK_DURATION_MINUTES=180
MAX_STREAM_RETRIES=2
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
# Directory where per-guild settings are persisted
DATA_DIR=data
EXTERNAL_PROCESS_TIMEOUT_MS=20000
VOICE_CONNECTION_TIMEOUT_MS=20000

# Feature flags & tuning
COMMAND_COOLDOWN_SECONDS=5
# Auto-delete bot confirmation messages after N seconds (0 disables). Messages with buttons are kept.
AUTO_DELETE_SECONDS=1
SPONSORBLOCK_CATEGORIES=sponsor,selfpromo
YTDLP_AUTO_UPDATE=true
# Optional: path to a yt-dlp cookies file for age-restricted / anti-bot videos.
# YTDLP_COOKIES_FILE=/app/cookies.txt
NOWPLAYING_LIVE=true
# Refresh interval of the live now-playing card (ms)
NOWPLAYING_INTERVAL_MS=5000
VOTE_SKIP_MIN=2
VOTE_SKIP_RATIO=0.5
VOLUME_STEP=5
SEEK_STEP_SECONDS=10
# Perceptual volume curve: 100% = -VOLUME_HEADROOM_DB, down to VOLUME_RANGE_DB spread
VOLUME_HEADROOM_DB=3
VOLUME_RANGE_DB=30
AUTOCOMPLETE_ENABLED=true
SUGGEST_TIMEOUT_MS=800
# Playlists: maximum number of tracks imported per playlist URL
PLAYLIST_MAX_ITEMS=50
# Autoplay: continue with related tracks when the queue runs out
AUTOPLAY_DEFAULT=false
AUTOPLAY_MAX_CONSECUTIVE=10
# Persist per-session queues so playback can resume after a restart
QUEUE_PERSIST=true
QUEUE_PERSIST_DEBOUNCE_MS=1000

# Extra sources ---------------------------------------------------------------
# Spotify is metadata-only (link resolved then searched on YouTube).
# Leave empty to disable the Spotify provider.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Lyrics (lrclib.net)
LYRICS_ENABLED=true
LYRICS_API_BASE=https://lrclib.net
LYRICS_TIMEOUT_MS=8000

# Direct HTTP(S) radio/stream fallback. Internal/loopback hosts are always
# refused to prevent SSRF. Optionally restrict playback to an exact allowlist
# of hostnames (comma-separated); empty means any public host is allowed.
# RADIO_ALLOWED_HOSTS=stream.example.com,radio.example.net
